{
  "name": "aithy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "aithy": {
    "llamaCppRelease": "b9253"
  },
  "scripts": {
    "start": "bun run scripts/start-web.ts dev --host 127.0.0.1 --port 3000 --strictPort",
    "dev": "bun run scripts/start-web.ts dev --host 127.0.0.1 --port 3000 --strictPort",
    "agent:worker": "bun run src/runtime/services/agent/worker.ts",
    "build": "bun --bun vite build",
    "preview": "bun run scripts/start-web.ts preview --host 127.0.0.1 --port 3000 --strictPort",
    "memory": "bun run scripts/memory.ts",
    "debug": "bun run scripts/debug.ts",
    "fresh-start": "bun run scripts/fresh-start.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "audit:deps": "bun run scripts/audit-dependencies.ts",
    "check:lines": "bun run scripts/check-lines.ts",
    "check:supply-chain": "bun run scripts/check-supply-chain.ts",
    "package:release": "bun run scripts/package-release.ts",
    "check": "bun run check:supply-chain && bun run check:lines && bun run typecheck && bun test",
    "ci": "bun ci && bun run check"
  },
  "dependencies": {
    "@ax-llm/ax": "24.0.15",
    "@huggingface/hub": "2.16.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "@types/node": "26.4.0",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "bonjour-service": "1.4.4",
    "bunqueue": "2.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "13.1.1",
    "lucide-react": "1.37.0",
    "microsandbox": "0.6.16",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sqlite-vec": "0.1.9",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "typescript": "7.0.2"
  },
  "overrides": {
    "protobufjs": "7.5.5"
  },
  "trustedDependencies": [
    "bun",
    "protobufjs",
    "sharp"
  ]
