{
  "name": "aithy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "aithy": {
    "llamaCppRelease": "b9253"
  },
  "scripts": {
    "start": "bun run scripts/start-web.ts dev --host 127.0.0.1 --port 3000 --strictPort",
    "dev": "bun run scripts/start-web.ts dev --host 127.0.0.1 --port 3000 --strictPort",
    "agent:worker": "bun run src/runtime/services/agent/worker.ts",
    "build": "bun --bun vite build",
    "preview": "bun run scripts/start-web.ts preview --host 127.0.0.1 --port 3000 --strictPort",
    "memory": "bun run scripts/memory.ts",
    "debug": "bun run scripts/debug.ts",
    "fresh-start": "bun run scripts/fresh-start.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "audit:deps": "bun run scripts/audit-dependencies.ts",
    "check:lines": "bun run scripts/check-lines.ts",
    "check:supply-chain": "bun run scripts/check-supply-chain.ts",
    "package:release": "bun run scripts/package-release.ts",
    "check": "bun run check:supply-chain && bun run check:lines && bun run typecheck && bun test",
    "ci": "bun ci && bun run check"
  },
  "dependencies": {
    "@ax-llm/ax": "23.0.0",
    "@huggingface/hub": "2.13.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@radix-ui/react-popover": "1.1.18",
    "@radix-ui/react-select": "2.3.2",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-switch": "1.3.2",
    "@radix-ui/react-tabs": "1.1.16",
    "@radix-ui/react-tooltip": "1.2.11",
    "@tailwindcss/postcss": "4.3.2",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/react-start": "1.168.26",
    "@types/node": "26.0.1",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "bonjour-service": "1.4.2",
    "bunqueue": "2.8.25",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.42.2",
    "lucide-react": "1.22.0",
    "microsandbox": "0.6.1",
    "postcss": "8.5.16",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sqlite-vec": "0.1.9",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.2",
    "vite": "8.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "typescript": "6.0.3"
  },
  "overrides": {
    "protobufjs": "7.5.5"
  },
  "trustedDependencies": [
    "bun",
    "protobufjs",
    "sharp"
  ]
}
