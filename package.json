{
  "name": "aithy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "start": "bun --bun vite dev --host 127.0.0.1 --port 3000 --strictPort",
    "dev": "bun --bun vite dev --host 127.0.0.1 --port 3000 --strictPort",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "memory": "bun run scripts/memory.ts",
    "debug": "bun run scripts/debug.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:lines": "bun run scripts/check-lines.ts",
    "check": "bun run check:lines && bun run typecheck && bun test"
  },
  "dependencies": {
    "@ax-llm/ax": "^21.0.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-start": "^1.167.64",
    "@types/node": "^25.6.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@xenova/transformers": "^2.17.2",
    "bunqueue": "^2.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "microsandbox": "^0.4.3",
    "postcss": "^8.5.14",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sqlite-vec": "^0.1.9",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "19.2.7",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "protobufjs",
    "sharp"
  ]
}
