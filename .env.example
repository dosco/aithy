# State and workspace.
# AITHY_BOT_ID=default
# AITHY_STATE_DIR=~/.config/aithy
# AITHY_WORKSPACE_ROOT=~/.config/aithy/default/workspace

# Sandbox execution.
AITHY_SANDBOX_PROVIDER=microsandbox
AITHY_SANDBOX_IMAGE=python:3.11-slim
AITHY_SANDBOX_CPUS=1
AITHY_SANDBOX_MEMORY_MB=512
AITHY_SANDBOX_NETWORK=none

# Host shell approvals.
# Set to false to remove system.bash from agent tools.
# AITHY_SYSTEM_BASH_ENABLED=true

# Runtime limits.
# AITHY_SESSION_TTL_MS=2700000
# AITHY_IDLE_PARK_MS=1800000
# AITHY_PARALLEL_AGENTS=3

# Parallel Search MCP.
# Anonymous public search works by default. Add a key only for higher limits.
# AITHY_PARALLEL_API_KEY=
# PARALLEL_API_KEY=
# AITHY_PARALLEL_SEARCH_MCP_URL=https://search.parallel.ai/mcp

# macOS SQLite extension override for hybrid retrieval.
# AITHY_SQLITE_DYLIB=/path/to/libsqlite3.dylib
