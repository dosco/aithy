# Optional: use local microVM isolation by default.
AITHY_SANDBOX_PROVIDER=microsandbox
AITHY_SANDBOX_IMAGE=python:3.11-slim
AITHY_SANDBOX_CPUS=1
AITHY_SANDBOX_MEMORY_MB=512
AITHY_SANDBOX_NETWORK=none

# Optional state overrides.
# AITHY_BOT_ID=default
# AITHY_STATE_DIR=~/.config/aithy

# Optional macOS SQLite extension override for hybrid retrieval.
# AITHY_SQLITE_DYLIB=/path/to/libsqlite3.dylib
